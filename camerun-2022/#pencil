<script>
(function(){
  var lb=document.getElementById('lb'),li=document.getElementById('lbi'),ld=document.getElementById('lbd'),
      lt=document.getElementById('lbt'),ln=document.getElementById('lbn'),list=[],cur=0,last=null;
  function render(){
    var img=list[cur],art=img.closest('article'),t=art&&art.querySelector('h2');
    li.src=img.getAttribute('src'); li.alt=img.alt;
    ld.textContent=t?t.textContent:''; lt.textContent=img.alt;
    ln.textContent=(cur+1)+' / '+list.length;
  }
  function open(img){
    list=Array.prototype.slice.call(document.querySelectorAll('#entries img'));
    cur=list.indexOf(img); last=img; render();
    lb.classList.add('on'); document.body.style.overflow='hidden';
    document.getElementById('lbx').focus();
  }
  function close(){lb.classList.remove('on');document.body.style.overflow='';li.removeAttribute('src');if(last)last.scrollIntoView({block:'center'});}
  function go(d){cur=(cur+d+list.length)%list.length;last=list[cur];render();}
  var ent=document.getElementById('entries'),skip=false;
  ent.addEventListener('click',function(e){var g=e.target.closest&&e.target.closest('.gal');skip=!!(g&&g.classList.contains('collapsed'));},true);
  ent.addEventListener('click',function(e){
    var t=e.target; if(t.tagName!=='IMG'||skip)return;
    open(t);
  });
  document.getElementById('lbx').onclick=close;
  document.getElementById('lbp').onclick=function(){go(-1);};
  document.getElementById('lbnx').onclick=function(){go(1);};
  document.getElementById('lbs').addEventListener('click',function(e){if(e.target.id==='lbs')close();});
  document.addEventListener('keydown',function(e){
    if(!lb.classList.contains('on'))return;
    if(e.key==='Escape')close(); else if(e.key==='ArrowRight')go(1); else if(e.key==='ArrowLeft')go(-1);
  });
  var x0=null,y0=null;
  lb.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;y0=e.touches[0].clientY;},{passive:true});
  lb.addEventListener('touchend',function(e){
    if(x0===null)return; var dx=e.changedTouches[0].clientX-x0, dy=e.changedTouches[0].clientY-y0; x0=null;
    if(Math.abs(dx)>45&&Math.abs(dx)>Math.abs(dy))go(dx<0?1:-1);
    else if(dy>90&&Math.abs(dy)>Math.abs(dx))close();
  },{passive:true});
})();
</script>
