<script>
(function(){
  var main=document.getElementById('entries'), menu=document.getElementById('menu');
  var btns=document.querySelectorAll('.order button');
  function sortBox(box,sel,key,order){
    var it=Array.prototype.slice.call(box.querySelectorAll(sel));
    it.sort(function(a,b){var x=key(a),y=key(b);return order==='asc'?(x<y?-1:1):(x<y?1:-1);});
    it.forEach(function(e){box.appendChild(e);});
  }
  function apply(order){
    sortBox(main,'article',function(a){return a.querySelector('time').getAttribute('datetime');},order);
    sortBox(menu,'.day',function(a){return a.dataset.date;},order);
    btns.forEach(function(b){b.setAttribute('aria-pressed', b.dataset.order===order?'true':'false');});
    try{localStorage.setItem('orden',order);}catch(e){}
  }
  btns.forEach(function(b){b.addEventListener('click',function(){apply(b.dataset.order);});});
  var saved='desc'; try{saved=localStorage.getItem('orden')||'desc';}catch(e){}
  apply(saved==='asc'?'asc':'desc');
  function route(){
    var hs=location.hash;
    if(hs.indexOf('#d-')===0&&document.getElementById(hs.slice(1))){
      document.body.classList.add('read');
      requestAnimationFrame(function(){document.getElementById(hs.slice(1)).scrollIntoView();});
    }else{
      document.body.classList.remove('read'); window.scrollTo(0,0);
    }
  }
  window.addEventListener('hashchange',route);
  main.querySelectorAll('article').forEach(function(art){
    if(art.querySelector('.art-back'))return;
    var d=document.createElement('div'); d.className='art-back';
    d.innerHTML='<a class="back" href="#">‹ Todos los días</a>';
    art.insertBefore(d,art.firstChild);
  });
  document.querySelectorAll('a.home,a.back').forEach(function(a){a.addEventListener('click',function(e){
    e.preventDefault(); if(location.hash){try{history.pushState('',document.title,location.pathname+location.search);}catch(err){location.hash='';}} route();
  });});
  route();
})();
</script>
<script>
(function(){
  function build(run){
    var gal=document.createElement('div'); gal.className='gal collapsed';
    run[0].parentNode.insertBefore(gal,run[0]);
    run.forEach(function(f){gal.appendChild(f);});
    var caps=document.createElement('p'); caps.className='caps';
    run.forEach(function(f,i){var c=f.querySelector('figcaption'); if(!c)return;
      var it=document.createElement('span'); it.className='it';
      var n=document.createElement('span'); n.className='n'; n.textContent=(i<9?'0':'')+(i+1);
      it.appendChild(n); it.appendChild(document.createTextNode(c.textContent)); caps.appendChild(it);});
    var btn=document.createElement('button'); btn.type='button'; btn.className='tg'; btn.textContent='Ver en grande'; btn.setAttribute('aria-expanded','false');
    gal.parentNode.insertBefore(caps,gal.nextSibling); caps.parentNode.insertBefore(btn,caps.nextSibling);
    function set(open){
      gal.classList.toggle('collapsed',!open);
      btn.textContent=open?'Recoger':'Ver en grande'; btn.setAttribute('aria-expanded',open?'true':'false');
      if(!open) gal.scrollIntoView({block:'nearest'});
    }
    btn.addEventListener('click',function(){set(gal.classList.contains('collapsed'));});
    gal.addEventListener('click',function(e){if(gal.classList.contains('collapsed')&&e.target.tagName==='IMG')set(true);});
  }
  document.querySelectorAll('#entries article').forEach(function(art){
    var kids=Array.prototype.slice.call(art.children),i=0;
    while(i<kids.length){
      if(kids[i].tagName==='FIGURE'&&!kids[i].classList.contains('lead')){
        var run=[]; while(i<kids.length&&kids[i].tagName==='FIGURE'&&!kids[i].classList.contains('lead')){run.push(kids[i]);i++;}
        build(run);
      }else i++;
    }
  });
})();
</script>
